#include <stdio.h>

int main()
{
    int q[5],front=0,rear=-1,n,i;

    printf("Enter number of elements: ");
    scanf("%d",&n);

    printf("Enter elements:\n");
    for(i=0;i<n;i++)
        scanf("%d",&q[++rear]);

    printf("Queue after insertion:\n");
    for(i=front;i<=rear;i++)
        printf("%d ",q[i]);

    printf("\nDeleted: %d",q[front++]);

    printf("\nQueue after deletion:\n");
    for(i=front;i<=rear;i++)
        printf("%d ",q[i]);

    return 0;
}
