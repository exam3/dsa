#include <stdio.h>

int main()
{
    int queue[5];
    int front = 0, rear = -1;
    int i;

    // Insert
    queue[++rear] = 10;
    queue[++rear] = 20;
    queue[++rear] = 30;

    printf("Queue after insertion:\n");

    for(i = front; i <= rear; i++)
    {
        printf("%d ", queue[i]);
    }

    // Delete
    printf("\nDeleted: %d", queue[front]);
    front++;

    printf("\nQueue after deletion:\n");

    for(i = front; i <= rear; i++)
    {
        printf("%d ", queue[i]);
    }

    return 0;
}
