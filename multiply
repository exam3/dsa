#include <stdio.h>
int main ()
{
int a[10] [10], b[10] [10],add [10] [10],mul[10] [10];
int i,j,k,r,c;
printf ("Enter rows and columns:");
scanf ("%d%d",&r,&c);

printf("Enter first matrix:\n");
for(i=0;i<r;i++)
for(j=0;j<c;j++)
scanf("%d",&a[i][j]);

printf("Enter second matrix:\n");
for(i=0;i<r;i++)
for(j=0;j<c;j++)
scanf("%d",&b[i][j]);

printf("\n Multiplication Matrix:\n");
for (i=0;i<r;i++)
{
for (j=0;j<c;j++)
{
mul[i][j]=0;
for (k=0;k<c;k++)
mul[i][j]+=a[i][k]*b[k][j];
printf("%d",mul[i][j]);
}
printf("\n");
}
return 0;
}
