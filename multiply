#include <stdio.h>

int main()
{
    int a[10][10],b[10][10],i,j,k,r,c,s;

    printf("Enter rows and columns:");
    scanf("%d%d",&r,&c);

    printf("Enter first matrix:\n");
    for(i=0;i<r;i++)
        for(j=0;j<c;j++) scanf("%d",&a[i][j]);

    printf("Enter second matrix:\n");
    for(i=0;i<r;i++)
        for(j=0;j<c;j++) scanf("%d",&b[i][j]);

    printf("\nMultiplication Matrix:\n");
    for(i=0;i<r;i++)
    {
        for(j=0;j<c;j++)
        {
            for(s=0,k=0;k<c;k++)
                s+=a[i][k]*b[k][j];
            printf("%d ",s);
        }
        printf("\n");
    }
    return 0;
}
